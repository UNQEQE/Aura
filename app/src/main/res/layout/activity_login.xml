<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="480dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:shadowColor="#66FFD54F"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="24"
            android:text="AURA FARM"
            android:textColor="#FFFFD54F"
            android:textSize="42sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:text="¿Quién va a farmear aura? ✨"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="username"
            android:background="@drawable/bg_pill"
            android:hint="Tu nombre"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textNoSuggestions"
            android:maxLength="16"
            android:maxLines="1"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#80FFFFFF"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/etPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="password"
            android:background="@drawable/bg_pill"
            android:hint="Contraseña (mín. 4 caracteres)"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#80FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvLoginError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#FFFF8A80"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_menu_p1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:text="ENTRAR"
            android:textColor="#FF00E5FF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_menu_p2"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:text="CREAR CUENTA NUEVA"
            android:textColor="#FFFF4081"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Tu nombre y tu récord quedan guardados en este celular. La contraseña evita que otro use tu cuenta."
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
