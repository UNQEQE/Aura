<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Cámara -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Esqueleto, halo, anillo y partículas -->
    <com.example.eliansitowebonsito.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Degradados para que el HUD se lea sobre cualquier fondo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <!-- Destello de pantalla al puntuar (el color se pone por código) -->
    <View
        android:id="@+id/viewFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- HUD (los marcadores, popups y paneles de cada jugador se inflan por código según 1 o 2 jugadores) -->
    <LinearLayout
        android:id="@+id/hudContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <!-- Marcadores: uno por jugador -->
        <LinearLayout
            android:id="@+id/hudRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <!-- Botones: volver al menú, sonido y reiniciar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="←"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp" />

            <!-- Diagnóstico de rendimiento: mantén presionado el puntaje del J1 para mostrarlo/ocultarlo -->
            <TextView
                android:id="@+id/tvDebug"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <View
                android:id="@+id/buttonsSpacer"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Mostrar / ocultar el esqueleto sobre la cámara -->
            <TextView
                android:id="@+id/btnSkeleton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="🦴"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnMute"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="🔊"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnReset"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="↺"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- Centro: popup del movimiento de cada jugador -->
        <LinearLayout
            android:id="@+id/popupRow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <!-- Movimiento que se está detectando (uno por jugador) -->
        <LinearLayout
            android:id="@+id/candidateRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:text="Ponte a ~2 metros y haz una pose para farmear aura ✨"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <!-- Guía de movimientos (toca uno para ver cómo se hace) -->
        <HorizontalScrollView
            android:id="@+id/chipScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
